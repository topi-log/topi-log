---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { SITE_TITLE } from '@/consts';
import { getSlideList } from '@/lib/slides';

const slides = await getSlideList();
---

<BaseLayout title={`Slides | ${SITE_TITLE}`} description="スライド一覧">
	<div class="flex flex-col gap-3">
		{slides.map((slide) => {
			const isExternal = slide.type === 'speakerdeck';
			const linkAttrs = isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};
			return (
				<div class="bg-white shadow-md p-5">
					<div class="flex flex-wrap items-center gap-2 mb-1">
						<p class="text-xs text-gray-400"><FormattedDate date={slide.date} /></p>
						{isExternal && (
							<span class="text-xs px-2 py-0.5 rounded-full bg-teal-50 text-teal-600">Speaker Deck</span>
						)}
						{slide.event && (
							<span class="text-xs px-2 py-0.5 rounded-full bg-sky-50 text-sky-500">{slide.event}</span>
						)}
						{slide.draft && (
							<span class="text-xs px-2 py-0.5 rounded-full bg-amber-50 text-amber-500">draft</span>
						)}
					</div>
					<a
						href={slide.url}
						class="block text-base font-medium text-gray-800 hover:text-sky-600 transition-colors no-underline mb-2"
						{...linkAttrs}
					>
						{slide.title}
					</a>
					{slide.description && (
						<p class="text-sm text-gray-500 leading-relaxed mb-4 line-clamp-2">{slide.description}</p>
					)}
					<div class="text-right">
						<a href={slide.url} class="text-xs text-sky-500 hover:text-sky-700 no-underline transition-colors" {...linkAttrs}>
							{isExternal ? 'Speaker Deckで見る ↗' : 'スライドを見る →'}
						</a>
					</div>
				</div>
			);
		})}
	</div>

	{slides.length === 0 && (
		<p class="text-center text-sm text-gray-400 py-8">スライドはまだありません</p>
	)}
</BaseLayout>
