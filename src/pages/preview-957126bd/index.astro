---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { getDraftPosts } from '@/lib/blog';
import { SITE_TITLE, PREVIEW_PATH } from '@/consts';

const drafts = await getDraftPosts();
---

<BaseLayout title={`下書きプレビュー | ${SITE_TITLE}`} description="下書きプレビュー" noindex>
	<h1 class="text-lg font-bold text-gray-800 mb-6">下書きプレビュー</h1>
	{drafts.length === 0 ? (
		<p class="text-sm text-gray-500">下書きはありません。</p>
	) : (
		<div class="flex flex-col gap-4">
			{drafts.map((post) => (
				<a href={`${PREVIEW_PATH}/${post.id}`} class="bg-white shadow-md p-5 no-underline hover:shadow-lg transition-shadow">
					<p class="text-sm font-bold text-gray-800 mb-2">{post.data.title}</p>
					<p class="text-xs text-gray-400"><FormattedDate date={post.data.pubDate} /></p>
					{post.data.tags && post.data.tags.length > 0 && (
						<div class="flex flex-wrap gap-2 mt-2">
							{post.data.tags.map((tag) => (
								<span class="text-xs bg-sky-50 text-sky-500 px-2 py-0.5 rounded-full">{tag}</span>
							))}
						</div>
					)}
				</a>
			))}
		</div>
	)}
</BaseLayout>
