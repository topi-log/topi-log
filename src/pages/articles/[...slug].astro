---
import { getCollection, render } from 'astro:content';
import BlogPost from '@/layouts/BlogPost.astro';
import LinkCardList from '@/components/LinkCardList.astro';
import { getBlogPosts, getDevPosts } from '@/lib/blog';
import koukanblog from '@/data/koukanblog.json';

export async function getStaticPaths() {
	const posts = await getBlogPosts();
	const devPosts = await getDevPosts();

	const blogPaths = posts.map((post) => ({
		params: { slug: post.id },
		props: { id: post.id, collection: 'blog' as const, pubDate: post.data.pubDate },
	}));

	const devPaths = devPosts.map((post) => ({
		params: { slug: `dev/${post.id}` },
		props: { id: post.id, collection: 'dev' as const, pubDate: new Date() },
	}));

	return [...blogPaths, ...devPaths];
}

const { id, collection, pubDate } = Astro.props;

let entry;

if (collection === 'dev') {
	const devCollection = await getCollection('dev');
	entry = devCollection.find((p) => p.id === id)!;
} else {
	const blogCollection = await getCollection('blog');
	entry = blogCollection.find((p) => p.id === id)!;
}

const { Content, headings } = await render(entry);
---

<BlogPost
	title={entry.data.title}
	pubDate={pubDate}
	tags={entry.data.tags}
	updatedDate={'updatedDate' in entry.data ? entry.data.updatedDate : undefined}
	isuconEntries={'isuconEntries' in entry.data ? entry.data.isuconEntries : undefined}
	headings={headings}
>
	<Content />
	{'koukanblogList' in entry.data && entry.data.koukanblogList && <LinkCardList urls={koukanblog.urls} />}
</BlogPost>
